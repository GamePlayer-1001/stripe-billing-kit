// Stripe Billing Kit 建表模板(Prisma)
// 追加到产品 schema.prisma 末尾后执行:prisma migrate dev --name add_billing

model BillingCustomer {
  userId           String   @id @map("user_id")
  stripeCustomerId String   @unique @map("stripe_customer_id")
  createdAt        DateTime @default(now()) @map("created_at")
  subscriptions    BillingSubscription[]

  @@map("billing_customers")
}

model BillingSubscription {
  stripeSubscriptionId String    @id @map("stripe_subscription_id")
  userId               String    @map("user_id")
  planKey              String    @map("plan_key")
  status               String
  currentPeriodEnd     DateTime? @map("current_period_end")
  cancelAtPeriodEnd    Boolean   @default(false) @map("cancel_at_period_end")
  raw                  Json
  syncedAt             DateTime  @default(now()) @map("synced_at")
  customer             BillingCustomer @relation(fields: [userId], references: [userId])

  @@index([userId, status])
  @@map("billing_subscriptions")
}

model BillingPurchase {
  stripeSessionId String   @id @map("stripe_session_id")
  userId          String   @map("user_id")
  planKey         String   @map("plan_key")
  amountTotal     Int      @map("amount_total")
  currency        String
  purchasedAt     DateTime @default(now()) @map("purchased_at")

  @@index([userId])
  @@map("billing_purchases")
}

model BillingEvent {
  stripeEventId String   @id @map("stripe_event_id")
  type          String
  processedAt   DateTime @default(now()) @map("processed_at")

  @@map("billing_events")
}

// ══════════════════════════════════════════════════════
// 佣金模块(可选:未启用 commission 时无需以下 4 个模型)
// 适配 prismaCommissionStorage,详见 docs/COMMISSION-SYSTEM-SPEC.md 4.1
// ══════════════════════════════════════════════════════

model ReferralCode {
  id             String   @id
  code           String   @unique
  userId         String   @unique @map("user_id")
  isActive       Boolean  @default(true) @map("is_active")
  totalInvites   Int      @default(0) @map("total_invites")
  convertedCount Int      @default(0) @map("converted_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("referral_codes")
}

model ReferralRelationship {
  id             String    @id
  referrerUserId String    @map("referrer_user_id")
  refereeUserId  String    @map("referee_user_id")
  originalCode   String    @map("original_code")
  status         String    @default("PENDING") // PENDING/ACTIVE/EXPIRED/TERMINATED
  createdAt      DateTime  @default(now()) @map("created_at")
  activatedAt    DateTime? @map("activated_at")
  metadata       Json?

  @@unique([referrerUserId, refereeUserId])
  @@index([refereeUserId, status])
  @@map("referral_relationships")
}

model CommissionRule {
  id                      String   @id
  programId               String   @map("program_id")
  planKey                 String?  @map("plan_key") // null = 全局适用
  triggerScope            String   @default("FIRST_PAYMENT") @map("trigger_scope")
  tierLevel               Int?     @map("tier_level") // null = 所有层级
  components              Json // RewardComponent[] 组件数组
  commissionBase          String   @default("NET_BASED") @map("commission_base")
  platformFeeHandlingMode String   @default("CONSUMED_BY_PLATFORM") @map("platform_fee_handling_mode")
  holdPeriodDays          Int      @default(30) @map("hold_period_days")
  autoApproveUnderCents   Int?     @map("auto_approve_under_cents")
  requireReviewOverCents  Int?     @map("require_review_over_cents")
  isActive                Boolean  @default(true) @map("is_active")
  priority                Int      @default(0)
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([programId, isActive])
  @@map("commission_rules")
}

model Commission {
  id             String   @id
  referrerUserId String   @map("referrer_user_id")
  orderId        String   @map("order_id")
  planKey        String   @map("plan_key")
  amount         Int // 现金佣金合计(cents)
  currency       String
  rateBreakdown  Json?    @map("rate_breakdown") // 组件计算明细快照(审计回溯)
  grantStatus    String   @default("NOT_APPLICABLE") @map("grant_status")
  tierLevel      Int      @default(1) @map("tier_level")
  status         String   @default("PENDING")
  reviewStatus   String   @default("AUTO_APPROVED") @map("review_status")
  validUntil     DateTime @map("valid_until")
  createdAt      DateTime @default(now()) @map("created_at")

  // 幂等键:webhook 重放/并发投递时数据库层拦截重复计佣
  @@unique([orderId, referrerUserId, tierLevel])
  @@index([referrerUserId, status])
  @@map("commissions")
}

// 人工审核队列(7.1 Level 2):commissionId 唯一,重复入队由 P2002 拦截
model AuditQueueItem {
  id           String    @id
  commissionId String    @unique @map("commission_id")
  reason       String // HIGH_AMOUNT / RAPID_GROWTH / SAME_DEVICE / ...
  riskScore    Int       @default(0) @map("risk_score") // 0-100
  riskFactors  Json?     @map("risk_factors") // ["high_amount", "temp_email"]
  status       String    @default("PENDING") // PENDING / IN_PROGRESS / APPROVED / REJECTED / ESCALATED
  assignedTo   String?   @map("assigned_to")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?   @map("review_notes")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([status, riskScore])
  @@map("audit_queue_items")
}

// 配置版本快照(8.2 版本控制):(programId, versionNumber) 唯一,快照 = 当时生效规则集
model ConfigurationVersion {
  id            String    @id
  programId     String    @map("program_id")
  versionNumber Int       @map("version_number")
  snapshot      Json // { rules: CommissionRuleRow[] }
  notes         String?
  createdBy     String?   @map("created_by") // 操作管理员 ID
  createdAt     DateTime  @default(now()) @map("created_at")
  activatedAt   DateTime? @map("activated_at")
  isLatest      Boolean   @default(false) @map("is_latest") // 当前生效版本(同一 program 至多一个 true)

  @@unique([programId, versionNumber])
  @@index([programId])
  @@map("configuration_versions")
}

// 打款记录(4.1 Payout):付佣腿唯一事实来源;idempotencyKey 唯一 = Layer 4 防重复打款
model Payout {
  id                    String    @id
  referrerUserId        String    @map("referrer_user_id")
  commissionIds         Json      @map("commission_ids") // 本次打款覆盖的佣金 ID 列表(批量结算)
  amount                Int // cents(各佣金之和)
  currency              String
  feeAmount             Int       @default(0) @map("fee_amount") // 通道手续费(如 PayPal $0.25/笔)
  provider              String // STRIPE_CONNECT / PAYPAL / MANUAL
  providerTransactionId String?   @map("provider_transaction_id") // 通道侧流水号(对账主键)
  idempotencyKey        String    @unique @map("idempotency_key") // = payout.id,防重复打款
  status                String    @default("CREATED") // CREATED/PROCESSING/SUCCEEDED/FAILED/UNCLAIMED/RETURNED
  failureReason         String?   @map("failure_reason")
  createdAt             DateTime  @default(now()) @map("created_at")
  processedAt           DateTime? @map("processed_at")
  settledAt             DateTime? @map("settled_at")

  @@index([referrerUserId])
  @@index([status])
  @@index([provider, providerTransactionId])
  @@map("payouts")
}

// Outbox 异步任务(5.4.2 webhook 快速响应):eventId 唯一,失败指数退避重试
model CommissionJob {
  id        String   @id
  eventId   String   @unique @map("event_id") // Stripe event.id,与 claimEvent 联动
  jobType   String   @map("job_type") // CALC_COMMISSION / CLAWBACK / GRANT_PRODUCT / PAYOUT
  payload   Json
  status    String   @default("PENDING") // PENDING / RUNNING / DONE / DEAD
  attempts  Int      @default(0)
  nextRunAt DateTime @default(now()) @map("next_run_at") // 指数退避重试
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status, nextRunAt])
  @@map("commission_jobs")
}
